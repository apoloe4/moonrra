name = "apoloe4/moonrra"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/apoloe4/moonrra"

license = "Apache-2.0"

keywords = [ "timeseries", "round-robin", "retention" ]

description = "Bounded multi-resolution time-series archives in pure MoonBit"

preferred_target = "wasm-gc"

warnings = "-implicit_impl_as_method"

import {
  "moonbitlang/async@0.22.9",
}
